{
  "permissions": {
    "allow": [
      "Bash(orca *)",
      "Bash(python3 tools/*)",
      "Bash(.venv/bin/python *)",
      "Bash(make *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(jq *)"
    ],
    "ask": [
      "Edit(src/brineguard/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/tools/session_brief.sh\" 2>/dev/null || true",
            "timeout": 45,
            "statusMessage": "Gathering session brief (git, memory, presences)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in */src/*.py|*/tests/*.py) cd \"${CLAUDE_PROJECT_DIR:-.}\" && out=$(.venv/bin/python -m pytest -q -x 2>&1) || { printf '%s\\n' \"$out\" | tail -20 >&2; exit 2; } ;; esac; }",
            "timeout": 90,
            "statusMessage": "Test gate: pytest on code edit"
          }
        ]
      }
    ]
  }
}
